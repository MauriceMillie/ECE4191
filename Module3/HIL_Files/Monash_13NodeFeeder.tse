            comment Comment13 START <!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN" "http://www.w3.org/TR/REC-html40/strict.dtd"><html><head><meta name="qrichtext" content="1" /><meta charset="utf-8" /><style type="text/css">p, li { white-space: pre-wrap; }hr { height: 1px; border-width: 0; }li.unchecked::marker { content: "\2610"; }li.checked::marker { content: "\2612"; }</style></head><body style=" font-family:'Sans'; font-size:12pt; font-weight:400; font-style:normal;"><p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;"><span style=" font-family:'Segoe UI'; font-size:16pt;">CPU transition components are used to partition <br />the signal processing circuit across two CPUs. <br />In SL 671, they act as a bridge between </span><span style=" font-family:'Segoe UI'; font-size:16pt; font-weight:700;">User CPU 0</span><span style=" font-family:'Segoe UI'; font-size:16pt;"> and the </span><span style=" font-family:'Segoe UI'; font-size:16pt; font-weight:700;">System CPU</span><span style=" font-family:'Segoe UI'; font-size:16pt;">.</span></p></body></html> ENDCOMMENT 
            [
                position = 7972, 10540
                background_color = #7001ff3c
            ]

            comment Comment14 START <!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN" "http://www.w3.org/TR/REC-html40/strict.dtd"><html><head><meta name="qrichtext" content="1" /><meta charset="utf-8" /><style type="text/css">p, li { white-space: pre-wrap; }hr { height: 1px; border-width: 0; }li.unchecked::marker { content: "\2610"; }li.checked::marker { content: "\2612"; }</style></head><body style=" font-family:'Sans'; font-size:12pt; font-weight:400; font-style:normal;"><p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;"><span style=" font-family:'Segoe UI'; font-size:16pt; font-weight:700;">CPU Marker components</span><span style=" font-family:'Segoe UI'; font-size:16pt;"> are used to assign parts<br /> of the signal processing circuit to a specific CPU.<br /> Here, they are used to assign the SP circuit to the System CPU.</span></p></body></html> ENDCOMMENT 
            [
                position = 7336, 10540
