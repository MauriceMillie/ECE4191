    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        
        ### Modbus Configuration
        
        gen_holding_addresses = ",".join([f"{i}i" for i in range(2000, 2064)])
        
        config1 = {
            "port": 502,
            "ip_addr": '192.168.122.10',  # ignore this ip and set in the modbus properties to 192.168.1.210
            "netmask": '255.255.255.0',
            "slave_id": 17,
            "coil_input_addresses": '0',
            "coil_output_addresses": '0',
            "discrete_input_addresses": '0',
            "holding_register_input_addresses": '0',
            "holding_register_output_addresses":gen_holding_addresses, 
            "input_register_addresses": '3000, 3001'
        }
        
        freq=60.0
        #ex_rate=12e-6 #Testing at 12us for stability
        ex_rate=180e-6
        Ts=18e-6
        w = 2.0*np.pi*freq
        
        Vnom_ph_to_ph = 4160.0
        Vnom = Vnom_ph_to_ph/np.sqrt(3)
        Vnom1 = 480.0/np.sqrt(3)
        Rshunt_msr = 1e4
        
        
        # Feet to miles conversion constant
        feet2mile = 0.000189394
        
        # -------- Calculating R and L values for load ----------
        # --------- Functions definition ---------
        def calc_R(V,P,S):
            R = V**2*P/S**2
            return R
            
        def calc_L(V,Q,S):
            XL = V**2*Q/S**2
            L = XL/(2*np.pi*freq)
            return L
        
        # ------- Cable configurations -----#
        
        # Cable configuration 601 parameters:
        R_601 = [[0.3465  , 0.1560, 0.1580], [0.1560, 0.3375, 0.1535], [0.1580, 0.1535, 0.3414]]
        L_601 = [[1.0179/w, 0.5017/w, 0.4236/w], [0.5017/w, 1.0478/w, 0.3849/w], [0.4236/w, 0.3849/w, 1.0348/w]]
        
        # Cable configuration 602 parameters:
        R_602 = [[0.7526  , 0.1580, 0.1560], [0.1580, 0.7475, 0.1535], [0.1560, 0.1535, 0.7436]]
        L_602 = [[1.1814/w, 0.4236/w, 0.5017/w], [0.4236/w, 1.983/w, 0.3849/w], [0.5017/w, 0.3849/w, 1.2112/w]]
        
