        <component_data>
                <id>2647601ea74611e68106101f740f3fa4</id>
                <name><![CDATA[Feeder Active Power PhaseA]]></name>
                <type>Gauge</type>
                <description><![CDATA[None]]></description>
                <data_type>Expression</data_type>
                <code><![CDATA[#----------------------- MANDATORY IMPORT --------------------------
# HIL Control Panel API

import numpy as np
# NOTE: Only read functions are available from HIL Control Panel API
#-------------------------------------------------------------------

# mandatory variable used for storing value
# that will be displayed
phase_1 = hil.read_analog_signals(['Node 632.V1_rms','Node 632.V1_phase','Node 632.I1_rms','Node 632.I1_phase'])
V1_rms      = phase_1[0]
V1_phase    = phase_1[1]
I1_rms      = phase_1[2]
I1_phase    = phase_1[3]

P1 = V1_rms*I1_rms*(np.cos(np.deg2rad(V1_phase-I1_phase)))

displayValue = P1/1e3]]></code>
                <signal_name><![CDATA[]]></signal_name>
                <unit><![CDATA[kW]]></unit>
                <automatic_unit>True</automatic_unit>
                <updateRate>500</updateRate>
                <decimals>2</decimals>
                <scaling_factor>1.0</scaling_factor>
                <widget_settings>
                    <x>0</x>
                    <y>0</y>
                    <width>224</width>
                    <height>136</height>
                    <appearance><![CDATA[Flat]]></appearance>
