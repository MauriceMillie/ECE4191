    # value to display
    "value": 55.0,
    # value unit
    "unit": "",
    # minimum value
    "minimum_value": 0.0,
    # maximum value
    "maximum_value": 100.0,
    # show warning and critical values
    "use_warning_critical": True,
    # warning value
    "warning_value": 70.0,
    # critical value
    "critical_value": 90.0,
    }

# list of bars data: [barData1, barData2,...barData10]
displayValue = [barData1]
]]></code>
